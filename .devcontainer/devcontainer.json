{
  "name": "BladeVault",
  "image": "mcr.microsoft.com/playwright:v1.62.1-noble",
  "workspaceFolder": "/workspaces/bladevault",
  "containerEnv": {
    "BLADEVAULT_DATA_DIR": "/root/BladeVault/data",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "mounts": [
    "source=bladevault-node-modules,target=/workspaces/bladevault/node_modules,type=volume",
    "source=bladevault-dev-data,target=/root/BladeVault/data,type=volume"
  ],
  "onCreateCommand": "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*",
  "postCreateCommand": "npm ci",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "BladeVault",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      }
    }
  },
  "init": true,
  "features": {
    "ghcr.io/devcontainer-config/features/dot-config:4": {}
  }
}
