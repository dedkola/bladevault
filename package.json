{
  "name": "bladevault",
  "version": "2.5.22",
  "private": true,
  "engines": {
    "node": "^24.18.1 || ^26.0.0"
  },
  "description": "A sharp, local-first knife collection manager.",
  "license": "MIT",
  "homepage": "https://github.com/dedkola/bladevault",
  "repository": {
    "type": "git",
    "url": "https://github.com/dedkola/bladevault.git"
  },
  "bugs": {
    "url": "https://github.com/dedkola/bladevault/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build && node scripts/build-mcp-cli.cjs",
    "build:static": "node scripts/build-static-app.cjs",
    "dev:static": "next dev static-app --webpack",
    "deploy:static": "wrangler deploy --config wrangler.static.jsonc",
    "mcp:build": "node scripts/build-mcp-cli.cjs",
    "mcp": "npm run mcp:build && node dist/mcp/bladevault.mjs mcp",
    "build:desktop": "npm run build && node scripts/prepare-desktop-build.cjs",
    "start": "next start",
    "desktop:dev": "node scripts/dev-desktop.cjs",
    "rebuild:desktop-native": "electron-rebuild -f -w better-sqlite3",
    "sync:desktop-runtime": "node scripts/sync-desktop-runtime-deps.cjs",
    "desktop:smoke": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && node scripts/run-desktop-smoke.cjs",
    "dist:desktop": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:desktop:dir": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "dist:desktop:mac:unsigned": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && BLADEVAULT_MAC_SIGN=0 BLADEVAULT_MAC_NOTARIZE=0 electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "dist:desktop:mac:signed": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && BLADEVAULT_MAC_SIGN=1 BLADEVAULT_MAC_NOTARIZE=1 electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "dist:desktop:linux": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && electron-builder --config electron-builder.config.cjs --linux --publish never",
    "verify:desktop:mac": "node scripts/verify-macos-release.cjs",
    "verify:desktop:windows-updater": "electron scripts/verify-windows-updater.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sentry/electron": "^8.4.0",
    "@sentry/nextjs": "^11.16.0",
    "better-sqlite3": "^13.2.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.11",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "next": "^16.4.5",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tar": "7.5.23",
    "unzipper": "^0.12.5",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "@types/yazl": "^3.3.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.16"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "core-js@3.50.0": true,
    "workerd@1.20261104.1": true
  }
}
