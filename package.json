{
  "name": "bladevault",
  "version": "1.0.1",
  "private": true,
  "description": "A sharp, local-first knife collection manager.",
  "homepage": "https://github.com/dedkola/bladevault",
  "repository": {
    "type": "git",
    "url": "https://github.com/dedkola/bladevault.git"
  },
  "bugs": {
    "url": "https://github.com/dedkola/bladevault/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "npm run build && node scripts/prepare-desktop-build.cjs",
    "start": "next start",
    "desktop:dev": "node scripts/dev-desktop.cjs",
    "rebuild:desktop-native": "electron-rebuild -f -w better-sqlite3",
    "sync:desktop-runtime": "node scripts/sync-desktop-runtime-deps.cjs",
    "desktop:smoke": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && node scripts/run-desktop-smoke.cjs",
    "dist:desktop": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:desktop:dir": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "dist:desktop:mac:unsigned": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && BLADEVAULT_MAC_SIGN=0 BLADEVAULT_MAC_NOTARIZE=0 electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "dist:desktop:mac:signed": "npm run build:desktop && npm run rebuild:desktop-native && npm run sync:desktop-runtime && BLADEVAULT_MAC_SIGN=1 BLADEVAULT_MAC_NOTARIZE=1 electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "verify:desktop:mac": "node scripts/verify-macos-release.cjs",
    "verify:desktop:windows-updater": "electron scripts/verify-windows-updater.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.30.0",
    "next": "^16.3.1",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tar": "7.5.22",
    "unzipper": "^0.12.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "@types/yazl": "^3.3.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.16"
    }
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.3.1": true,
    "protobufjs@7.6.4": true,
    "re2@1.24.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "core-js@3.49.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.2": true
  }
}
